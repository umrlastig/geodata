                                                "hvd" ,
                                                "routes" ,
                                                "toponymie" ,
                                                "transports" ,
                                                "végétation" ,
                                                "énergies" ;
            <http://www.w3.org/ns/dcat#language> "fr-FR" ;
            <http://www.w3.org/ns/dcat#publisher> <https://ign.fr> .

