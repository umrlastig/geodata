  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@value" : "BD TOPO®"
  } ],
  "http://schema.org/encodingFormat" : [ {
    "@value" : "GPKG"
  }, {
    "@value" : "PostGreSQL"
  }, {
    "@value" : "SHP"
  }, {
    "@value" : "TMS"
