}, {
  "@id" : "http://purl.org/www.umr-lastig.fr/geodata",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@value" : "Ana-Maria Raimond"
  }, {
    "@value" : "Benedicte Bucher"
  }, {
    "@value" : "Marie-Dominique Van Damme"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "fr",
    "@value" : "Ontologie des jeux de données géographiques pour la science ouverte"
  }, {
    "@language" : "en",
    "@value" : "Ontology of Geospatial Datasets for Open Science"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "geodata"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@id" : "https://intforout.github.io/geodata#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A knowledge graph, including a vocabulary and instances, that represents datasets, papers, storymaps, pedagogic material and processes, altogether referred to as catalogued resources, that need to be shared, discovered or reused in order to produce new knowledge or to produce pedagogic material to disseminate knowledge. The object property \"represents\" connects a catalogued resource with a concept. Specific concepts are introduced in projects that use Geodata to describe more precisely the knowledge at stake."
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core"
  }, {
    "@id" : "http://www.w3.org/ns/dcat3"
  }, {
    "@id" : "http://www.w3.org/ns/prov#"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/"
  }, {
    "@id" : "http://www.w3.org/ns/ssn/"
  }, {
    "@id" : "http://xmlns.com/foaf/0.1/"
  } ]
}, {
  "@id" : "http://purl.org/www.umr-lastig.fr/geodata#ActiveMobilityCounter",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Pedestrian and cyclist flows are measured using an active mobility counting system (automatic bicycle and pedestrian counter) installed along the study area."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Bicycle and pedestrian counter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.org/www.umr-lastig.fr/geodata#DataCollectionInstrument"
  } ]
}, {
  "@id" : "http://purl.org/www.umr-lastig.fr/geodata#CameraTrap",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "photographic device with any type of trigger causing a photo to be taken when activity is present"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Camera trap"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "http://www.wikidata.org/entity/Q1723004"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.org/www.umr-lastig.fr/geodata#DataCollectionInstrument"
  } ]
}, {
  "@id" : "http://purl.org/www.umr-lastig.fr/geodata#Collection",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Collection of items that supports the usage of geodata for a pedagogic or learning purpose, in relationship with given concepts"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/dcat#Resource"
  } ]
}, {
  "@id" : "http://purl.org/www.umr-lastig.fr/geodata#Data",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Any data"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Data"
  } ]
}, {
  "@id" : "http://purl.org/www.umr-lastig.fr/geodata#DataCollectionInstrument",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "tool used to facilitate the collection of qualitative or quantitative data"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Data collection instrument"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@value" : "http://www.wikidata.org/entity/Q130941907"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
