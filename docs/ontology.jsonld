    "@value" : "Ana-Maria Raimond"
  }, {
    "@value" : "Benedicte Bucher"
  }, {
    "@value" : "Marie-Dominique Van Damme"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "fr",
    "@value" : "Ontologie des jeux de données géographiques pour la science ouverte"
  }, {
    "@language" : "en",
    "@value" : "Ontology of Geospatial Datasets for Open Science"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "geodata"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@id" : "http://www.umr-lastig.fr/geodata#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A knowledge graph, including a vocabulary and instances, that represents datasets, papers, storymaps, pedagogic material and processes, altogether referred to as catalogued resources, that need to be shared, discovered or reused in order to produce new knowledge or to produce pedagogic material to disseminate knowledge. The object property \"represents\" connects a catalogued resource with a concept. Specific concepts are introduced in projects that use Geodata to describe more precisely the knowledge at stake."
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "http://www.w3.org/ns/dcat3"
  }, {
    "@id" : "http://www.w3.org/ns/prov#"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/"
  }, {
    "@id" : "http://www.w3.org/ns/ssn/"
  } ]
}, {
  "@id" : "http://purl.org/www.umr-lastig.fr/geodata#ActiveMobilityCounter",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Pedestrian and cyclist flows are measured using an active mobility counting system (automatic bicycle and pedestrian counter) installed along the study area."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Bicycle and pedestrian counter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.org/www.umr-lastig.fr/geodata#DataCollectionInstrument"
  } ]
}, {
  "@id" : "http://purl.org/www.umr-lastig.fr/geodata#BD_TOPO_V3",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#dateTime",
    "@value" : "2002-12-15T01:00:00"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "La BD TOPO® version 3.5 contient une description vectorielle 3D (structurée en objets) des éléments du territoire et de ses infrastructures, de précision métrique.\n\n            Les objets de la BD TOPO® sont structurés en thèmes : \n            - l'administratif ; \n            - le bâti ; \n            - l'hydrographie ; \n            - les lieux nommés ; \n            - l'occupation du sol ; \n            - les services et activités ; \n            - le transport ; \n            - les zones réglementées. \n\n            Le processus de production 3D permet de fournir l'altimétrie des objets, ainsi que la hauteur des bâtiments. \n\n            Le relief est décrit sous forme de modèles numériques de terrain (MNT). \n\n            Depuis la version 3.0, tous les objets possèdent un identifiant unique et stable dans le temps.\n\n            Le produit BDTOPO® Express est l’édition hebdomadaire de la BDTOPO® si vous avez besoin de travailler sur de la donnée topographique à haute fréquence (disponible depuis mai 2025). \n\n            Le produit Différentiel BD TOPO® contient les différences géométriques et sémantiques sur l'ensemble du contenu BD TOPO® entre deux éditions trimestrielles successives BD TOPO®. \n\n            Plus précisément, l'édition N du Différentiel BD TOPO® en vigueur contient tout objet de la BD TOPO® dont la date de modification, la date de création ou la date de suppression en base est postérieure à la date de prédiffusion de la précédente édition trimestrielle (N-1), équivalent à une activité de mise à jour par l'IGN d'une durée de 3 mois."
  } ],
  "http://purl.org/dc/terms/identifier" : [ {
    "@value" : "IGNF_BD-TOPO"
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#dateTime",
    "@value" : "2025-09-15T02:00:00"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#dateTime",
    "@value" : "2026-07-03T02:00:00"
