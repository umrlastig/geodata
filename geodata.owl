    <!-- http://purl.org/dc/dcmitype/Software -->

    <owl:Class rdf:about="http://purl.org/dc/dcmitype/Software"/>
    


    <!-- http://purl.org/dc/terms/Agent -->

    <owl:Class rdf:about="http://purl.org/dc/terms/Agent"/>
    


    <!-- http://purl.org/dc/terms/MethodOfInstruction -->

    <owl:Class rdf:about="http://purl.org/dc/terms/MethodOfInstruction"/>
    


    <!-- http://purl.org/dc/terms/PeriodOfTime -->

    <owl:Class rdf:about="http://purl.org/dc/terms/PeriodOfTime"/>
    


    <!-- http://purl.org/dc/terms/ProvenanceStatement -->

    <owl:Class rdf:about="http://purl.org/dc/terms/ProvenanceStatement"/>
    


    <!-- http://purl.org/spar/datacite/Resource -->

    <owl:Class rdf:about="http://purl.org/spar/datacite/Resource"/>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#ActiveMobilityCounter -->

    <owl:Class rdf:about="http://purl.org/www.umr-lastig.fr/geodata#ActiveMobilityCounter">
        <rdfs:subClassOf rdf:resource="http://purl.org/www.umr-lastig.fr/geodata#DataCollectionInstrument"/>
        <rdfs:comment xml:lang="en">Pedestrian and cyclist flows are measured using an active mobility counting system (automatic bicycle and pedestrian counter) installed along the study area.</rdfs:comment>
        <rdfs:label xml:lang="en">Bicycle and pedestrian counter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#CameraTrap -->

    <owl:Class rdf:about="http://purl.org/www.umr-lastig.fr/geodata#CameraTrap">
        <rdfs:subClassOf rdf:resource="http://purl.org/www.umr-lastig.fr/geodata#DataCollectionInstrument"/>
        <rdfs:comment xml:lang="en">photographic device with any type of trigger causing a photo to be taken when activity is present</rdfs:comment>
        <rdfs:label xml:lang="en">Camera trap</rdfs:label>
        <rdfs:seeAlso>http://www.wikidata.org/entity/Q1723004</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#Collection -->

    <owl:Class rdf:about="http://purl.org/www.umr-lastig.fr/geodata#Collection">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#Resource"/>
        <rdfs:comment xml:lang="en">Collection of items that supports the usage of geodata for a pedagogic or learning purpose, in relationship with given concepts</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#Data -->

    <owl:Class rdf:about="http://purl.org/www.umr-lastig.fr/geodata#Data">
        <rdfs:comment xml:lang="en">Any data</rdfs:comment>
        <rdfs:label xml:lang="en">Data</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#DataClass -->

    <owl:Class rdf:about="http://purl.org/www.umr-lastig.fr/geodata#DataClass">
        <terms:description>Class of objects in a Dataset, e.g. BDTopo Buildings</terms:description>
    </owl:Class>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#DataCollectionInstrument -->

    <owl:Class rdf:about="http://purl.org/www.umr-lastig.fr/geodata#DataCollectionInstrument">
        <owl:equivalentClass rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">tool used to facilitate the collection of qualitative or quantitative data</rdfs:comment>
        <rdfs:label xml:lang="en">Data collection instrument</rdfs:label>
        <rdfs:seeAlso>http://www.wikidata.org/entity/Q130941907</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#GPSDevice -->

    <owl:Class rdf:about="http://purl.org/www.umr-lastig.fr/geodata#GPSDevice">
        <rdfs:subClassOf rdf:resource="http://purl.org/www.umr-lastig.fr/geodata#DataCollectionInstrument"/>
        <rdfs:comment xml:lang="en">navigation device that uses the Global Positioning System to track the device&apos;s movements and determine its geographic position</rdfs:comment>
        <rdfs:label xml:lang="en">GPS sensor</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q253677</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#PedagogicMaterial -->

    <owl:Class rdf:about="http://purl.org/www.umr-lastig.fr/geodata#PedagogicMaterial">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#Resource"/>
        <rdfs:comment xml:lang="en">Ready to use material to teach a given competence, in relationship with concepts, to a given audience. For example a wikipedia page, a storymap, a GIS exercise, an outdoor educational activity.</rdfs:comment>
        <rdfs:label xml:lang="en">Pedagogic material</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#Process -->

    <owl:Class rdf:about="http://purl.org/www.umr-lastig.fr/geodata#Process">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#Resource"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <terms:description>Series of events which occur over an extended period of time, a particular type of processes can be sets of operations to yield an output based on an input</terms:description>
        <rdfs:seeAlso>http://eurovoc.europa.eu/3640</rdfs:seeAlso>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q3249551</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#ScientificPaper -->

    <owl:Class rdf:about="http://purl.org/www.umr-lastig.fr/geodata#ScientificPaper">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/datacite/Resource"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#Resource"/>
        <rdfs:comment xml:lang="en">Scientific papers are for sharing your own original research work with other scientists or for reviewing the research conducted by others.</rdfs:comment>
        <rdfs:label xml:lang="fr">Papier scientifique</rdfs:label>
        <rdfs:label xml:lang="en">Scientific Paper</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#ScientificSurvey -->

    <owl:Class rdf:about="http://purl.org/www.umr-lastig.fr/geodata#ScientificSurvey">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment xml:lang="en">An organized data acquisition activity carried out according to a defined methodology, using appropriate instruments or protocols, in order to observe, measure, or document phenomena for scientific analysis</rdfs:comment>
        <rdfs:label xml:lang="en">Scientific survey</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#TotalStation -->

    <owl:Class rdf:about="http://purl.org/www.umr-lastig.fr/geodata#TotalStation">
        <rdfs:subClassOf rdf:resource="http://purl.org/www.umr-lastig.fr/geodata#DataCollectionInstrument"/>
        <rdfs:comment xml:lang="en">A total station is a theodolite coupled with a distance meter. It is used to measure vertical and horizontal angles and distances.</rdfs:comment>
        <rdfs:label xml:lang="fr">Tachéomètre</rdfs:label>
        <rdfs:label xml:lang="en">Total station</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q641296</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#UserFeedback -->

    <owl:Class rdf:about="http://purl.org/www.umr-lastig.fr/geodata#UserFeedback">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#Resource"/>
        <rdfs:comment xml:lang="en">An explicit information shared by a participants relative to his own experience with one or more datasets, tools or paper.</rdfs:comment>
        <rdfs:label xml:lang="en">User feedback</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2000/10/swap/pim/contact#Person -->

    <owl:Class rdf:about="http://www.w3.org/2000/10/swap/pim/contact#Person"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->

