<?xml version="1.0"?>
<rdf:RDF xmlns="http://purl.org/www.umr-lastig.fr/geodata/"
     xml:base="http://purl.org/www.umr-lastig.fr/geodata/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://www.w3.org/2003/06/sw-vocab-status/ns#"
     xmlns:org="http://www.w3.org/ns/org#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:pav="http://purl.org/pav/"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:wot="http://xmlns.com/wot/0.1/"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:adms="http://www.w3.org/ns/adms#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:core="http://purl.org/vocab/frbr/core#"
     xmlns:dcam="https://www.dublincore.org/specifications/dublin-core/dcmi-terms/"
     xmlns:dcat="http://www.w3.org/ns/dcat#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:topo="http://data.ign.fr/def/topo#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:dcam1="http://purl.org/dc/dcam/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vcard="http://www.w3.org/2006/vcard/ns#"
     xmlns:vocab="http://www.w3.org/1999/xhtml/vocab#"
     xmlns:schema="http://schema.org/">
    <owl:Ontology rdf:about="http://purl.org/www.umr-lastig.fr/geodata">
        <owl:imports rdf:resource="http://www.w3.org/ns/dcat3"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/prov#"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/sosa/"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/ssn/"/>
        <dc:creator>Ana-Maria Raimond</dc:creator>
        <dc:creator>Benedicte Bucher</dc:creator>
        <dc:creator>Marie-Dominique Van Damme</dc:creator>
        <terms:title xml:lang="fr">Ontologie des jeux de données géographiques pour la science ouverte</terms:title>
        <terms:title xml:lang="en">Ontology of Geospatial Datasets for Open Science</terms:title>
        <vann:preferredNamespacePrefix>geodata</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="http://www.umr-lastig.fr/geodata#"/>
        <rdfs:comment>A knowledge graph, including a vocabulary and instances, that represents datasets, papers, storymaps, pedagogic material and processes, altogether referred to as catalogued resources, that need to be shared, discovered or reused in order to produce new knowledge or to produce pedagogic material to disseminate knowledge. The object property &quot;represents&quot; connects a catalogued resource with a concept. Specific concepts are introduced in projects that use Geodata to describe more precisely the knowledge at stake.</rdfs:comment>
    </owl:Ontology>
    


