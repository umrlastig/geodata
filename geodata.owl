    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#annotates -->

    <owl:ObjectProperty rdf:about="http://purl.org/www.umr-lastig.fr/geodata#annotates">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <rdfs:comment>Relation between a dataset that is a set of annotations for another dataset, e.g. an annotation layer in a QGIS project.</rdfs:comment>
        <rdfs:label xml:lang="en">annotates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#hasMethodOfInstruction -->

    <owl:ObjectProperty rdf:about="http://purl.org/www.umr-lastig.fr/geodata#hasMethodOfInstruction">
        <rdfs:domain rdf:resource="http://purl.org/www.umr-lastig.fr/geodata#Collection"/>
        <rdfs:range rdf:resource="http://purl.org/dc/terms/MethodOfInstruction"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#has_member -->

    <owl:ObjectProperty rdf:about="http://purl.org/www.umr-lastig.fr/geodata#has_member">
        <rdfs:domain rdf:resource="http://purl.org/www.umr-lastig.fr/geodata#Collection"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#isRepresentedBy -->

    <owl:ObjectProperty rdf:about="http://purl.org/www.umr-lastig.fr/geodata#isRepresentedBy">
        <owl:inverseOf rdf:resource="http://purl.org/www.umr-lastig.fr/geodata#represents"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#Resource"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#represents -->

    <owl:ObjectProperty rdf:about="http://purl.org/www.umr-lastig.fr/geodata#represents">
        <owl:inverseOf rdf:resource="http://purl.org/www.umr-lastig.fr/geodata#isRepresentedBy"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Resource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Connect digital assets that are useful to derive meaningful representations of interests expressed with non digital concepts. It is a generic property that is inferred from the following : either a concept is present in the topicCategories, keywords, themes, application schema of a given asset.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#target -->

    <owl:ObjectProperty rdf:about="http://purl.org/www.umr-lastig.fr/geodata#target">
        <rdfs:domain rdf:resource="http://purl.org/www.umr-lastig.fr/geodata#UserFeedback"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#Resource"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/www.umr-lastig.fr/geodata#typeOfProvidedFeatures -->

    <owl:ObjectProperty rdf:about="http://purl.org/www.umr-lastig.fr/geodata#typeOfProvidedFeatures">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/www.umr-lastig.fr/geodata#Process"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/dcat#Dataset"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <terms:description xml:lang="en">Class of some features that belong to the dataset (or to the dataset computed by the process)</terms:description>
    </owl:ObjectProperty>
    


